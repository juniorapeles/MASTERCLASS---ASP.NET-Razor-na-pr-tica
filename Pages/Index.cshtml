@page
@model MyRazorApp.Pages.Index
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>

<html lang="pt-br">
<head>
    <title></title>
</head>
<body>
<div>
    <partial name="Shared/NavMenuPartial" />
    <h1>Categorias</h1>
    <table>
        <thead>
        <tr>
            <td>ID</td>
            <td>Title</td>
            <td>Price</td>
        </tr>
        </thead>
        <tbody>
        @foreach (var category in Model.Categories)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Title</td>
                <td>@category.Price.ToString("C")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
</body>
</html>